{
  "name": "kse-hub-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "npm run build:client && tsc",
    "start": "node dist/dev.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "build:client": "cd ../client && npm install && npm run build && cd ../server && rm -rf public && cp -r ../client/dist ./public",
    "typecheck": "tsc --noEmit",
    "db:sql": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/run-sql.mjs",
    "test": "node --import tsx --test \"src/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/functions": "^2.2.13",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.36.4",
    "grammy": "^1.46.0",
    "hono": "^4.7.4",
    "ical.js": "^2.1.0",
    "node-ical": "^0.27.2",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
