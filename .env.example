# ─── Telegram ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_SECRET=your_bot_secret_here
# Protects /cron/tick; the same value goes into GitHub → Settings → Secrets → CRON_SECRET
CRON_SECRET=any_long_random_string

# ─── Database (Neon) ───
DATABASE_URL=postgresql://kse_hub:kse_hub_secret@localhost:5432/kse_hub

# ─── OpenAI ───
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Moodle ───
MOODLE_BASE_URL=https://teaching.kse.org.ua

# ─── App ───
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
