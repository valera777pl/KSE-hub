# ─── Telegram ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_SECRET=your_bot_secret_here
# Protects /cron/tick; cron-job.org sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=any_long_random_string

# ─── Database (Neon) ───
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── App ───
# Local dev only (on Vercel these come from the platform)
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ─── Google (Gmail + Calendar, Internal OAuth app in kse.org.ua) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts Google refresh tokens in the DB: openssl rand -hex 32
TOKEN_ENC_KEY=

# ─── AI (assistant + email summaries): Gemini from aistudio.google.com ───
GEMINI_API_KEY=
# Optional, default gemini-flash-lite-latest (3.5-flash free tier is only 20 requests/day)
GEMINI_MODEL=
